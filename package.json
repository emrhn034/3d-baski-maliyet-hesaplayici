{
  "name": "3d-baski-maliyet-hesaplayici",
  "version": "1.2.0",
  "productName": "3D Baskı Maliyet Hesaplayıcı",
  "main": "desktop/main.cjs",
  "author": "emrhn034",
  "private": true,
  "description": "Türkçe 3D baskı maliyet, kâr ve satış fiyatı hesaplayıcı",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "electron desktop/smoke.cjs",
    "build:win": "electron-builder --win portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.emrhn034.baskimaliyet",
    "asar": true,
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["docs/**/*", "desktop/main.cjs", "desktop/smoke.cjs", "build/icon.ico", "package.json"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "executableName": "3D-Baski-Maliyet"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "3D-Baski-Maliyet.exe"
    }
  }
}
